{
    "job_name": "kun01wu_mvla_h20probe",
    "workspace_folder": "/jfs-public/users/kun01.wu/robo_orchard_lab/aidi_workspace/submit-kun01wu_mvla_h20probe",
    "docker_image": "docker.hobot.cc/imagesys/robotlab-mani:ubuntu2204-gcc11.4-cu128-nccl2277-torch280-erdma-tf5102-robodojo-v0.5",
    "input_bucket": "robot_lab,robot_lab2",
    "output_bucket": "robot_lab,robot_lab2",
    "num_workers": 1,
    "gpu_per_worker": 1,
    "wall_time": 180,
    "cmd": [
        "export PYTHONPATH=${WORKING_PATH}:$PYTHONPATH",
        "export XDG_CACHE_HOME=/tmp/c TRITON_CACHE_DIR=/tmp/c/triton TORCHINDUCTOR_CACHE_DIR=/tmp/c/inductor TORCH_HOME=/tmp/c/torch HF_HOME=/tmp/c/hf MPLCONFIGDIR=/tmp/c/mpl TMPDIR=/tmp/c/tmp",
        "mkdir -p /tmp/c/triton /tmp/c/inductor /tmp/c/torch /tmp/c/hf /tmp/c/mpl /tmp/c/tmp",
        "mkdir -p /horizon-bucket/robot_lab/users/kun01.wu/benchmarks/robodojo/eval_runs/robodojo-mvla-h20probe-20260811/logs /job_data/eval_out",
        "CAP=/horizon-bucket/robot_lab/users/kun01.wu/benchmarks/robodojo/eval_runs/robodojo-mvla-h20probe-20260811/logs/h20_probe.txt",
        "echo \"=== H20 probe $(date -u +%FT%TZ) uid=$(id -u) host=$(hostname) ===\" | tee -a $CAP",
        "echo '--- [1] mounts' | tee -a $CAP",
        "(mount | grep -E 'horizon-bucket|job_data|jfs' || echo NONE) | tee -a $CAP",
        "echo '--- [2] real open() on bucket' | tee -a $CAP",
        "/usr/bin/python3 -c \"p='/horizon-bucket/robot_lab/users/kun01.wu/robo_orchard_lab/ckpts/memoryvla_eval_pkgs/100k_memory6_mem/model.config.json';open(p,'rb').read(64);print('OPEN OK',p)\" 2>&1 | tee -a $CAP",
        "/usr/bin/python3 -c \"p='/horizon-bucket/robot_lab2/datasets/assets/robodojo_assets/Eval_Layout/RoboDojo/arx_x5/0/cover_blocks_0.json';open(p,'rb').read(64);print('OPEN OK',p)\" 2>&1 | tee -a $CAP",
        "echo '--- [3] /job_data writable' | tee -a $CAP",
        "touch /job_data/eval_out/.wtest && echo JOB_DATA_WRITABLE | tee -a $CAP || echo FATAL_job_data_not_writable | tee -a $CAP",
        "echo '--- [4] gpu + torch arch list' | tee -a $CAP",
        "nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader 2>&1 | tee -a $CAP",
        "/usr/bin/python3 -c \"import torch;print('torch',torch.__version__);print('arch',torch.cuda.get_arch_list());print('cap',torch.cuda.get_device_capability(0))\" 2>&1 | tee -a $CAP",
        "echo '--- [5] Isaac Sim: 2 episodes of cover_blocks' | tee -a $CAP",
        "set +e",
        "/usr/bin/python3 robodojo_eval.py \\",
        "  --policy_source \"${WORKING_PATH}/holobrain_robodojo_policy\" \\",
        "  --model_dir '/horizon-bucket/robot_lab/users/kun01.wu/robo_orchard_lab/ckpts/memoryvla_eval_pkgs/100k_memory6_mem/' \\",
        "  --model_processor robodojo_arx_x5a_processor \\",
        "  --env_config arx_x5 \\",
        "  --eval_num 2 \\",
        "  --processes_per_gpu 1 \\",
        "  --seed 0 \\",
        "  --vlm_ckpt_dir /horizon-bucket/robot_lab/users/xuewu.lin/ckpt \\",
        "  --urdf_dir /horizon-bucket/robot_lab2/datasets/all_data/urdf/urdf_v20260711 \\",
        "  --eval_result_dir /job_data/eval_out \\",
        "  --run_tag h20probe_cover_blocks \\",
        "  --tasks 'cover_blocks' 2>&1 | tail -120 | tee -a $CAP",
        "RC=${PIPESTATUS[0]}",
        "echo \"--- [6] eval rc=$RC\" | tee -a $CAP",
        "(grep -ciE 'raytracing|OUT_OF_DEVICE_MEMORY|VK_ERROR' $CAP | xargs -I{} echo 'vulkan/rt error lines: {}') | tee -a $CAP",
        "cp -r /job_data/eval_out/. /horizon-bucket/robot_lab/users/kun01.wu/benchmarks/robodojo/eval_runs/robodojo-mvla-h20probe-20260811/ 2>&1 | tail -3 || true",
        "find /horizon-bucket/robot_lab/users/kun01.wu/benchmarks/robodojo/eval_runs/robodojo-mvla-h20probe-20260811 -name _result.json | tee -a $CAP",
        "echo \"PROBE DONE rc=$RC $(date -u +%FT%TZ)\" | tee -a $CAP",
        "exit 0"
    ],
    "to_upload": [
        "robo_orchard_lab",
        "projects/holobrain_internal/common/holobrain_robodojo_policy",
        "projects/holobrain_internal/common/robodojo_eval.py"
    ],
    "job_password": "1227",
    "queue_name": "project-h20-horizon-labs-acloud",
    "project_id": "horizon-labs"
}
